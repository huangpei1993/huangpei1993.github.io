<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="drawio" version="26.0">
  <diagram name="支付闭环时序与状态">
    <mxGraphModel dx="1800" dy="1200" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1900" pageHeight="1250" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="AIGO 支付状态闭环：准备支付 → 渠道确认 → 统一持久化 → 前端感知" style="text;html=1;strokeColor=none;fillColor=none;fontSize=22;fontStyle=1;fontColor=#243b53;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="1700" height="40" as="geometry" />
        </mxCell>
        <mxCell id="seqTitle" value="一、请求与回调时序（已实现路径）" style="text;html=1;strokeColor=none;fillColor=none;fontStyle=1;fontColor=#243b53;fontSize=16;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="75" width="500" height="30" as="geometry" />
        </mxCell>
        <mxCell id="frontend" value="前端&#xa;orderPay / paymentReturn" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#243b53;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="70" y="130" width="180" height="70" as="geometry" />
        </mxCell>
        <mxCell id="gateway" value="Gateway&#xa;订单控制器 / payment_public" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontColor=#7a4b00;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="330" y="130" width="220" height="70" as="geometry" />
        </mxCell>
        <mxCell id="order" value="Order 服务&#xa;V2 复用 V1 支付同步" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontColor=#4d2d5f;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="630" y="130" width="220" height="70" as="geometry" />
        </mxCell>
        <mxCell id="strategy" value="IPayStrategy&#xa;Pay / Query / Verify / Refund" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#243b53;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="930" y="130" width="230" height="70" as="geometry" />
        </mxCell>
        <mxCell id="provider" value="支付渠道&#xa;default / Alipay / WeChat 占位" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#444444;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1240" y="130" width="230" height="70" as="geometry" />
        </mxCell>
        <mxCell id="db" value="oms_order_payment&#xa;PENDING 流水 + version" style="shape=cylinder3;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#285943;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1510" y="130" width="180" height="70" as="geometry" />
        </mxCell>
        <mxCell id="e1" value="准备支付" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#6c8ebf;fontColor=#243b53;" edge="1" parent="1" source="frontend" target="gateway">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e2" value="gRPC PreparePayment" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#6c8ebf;fontColor=#243b53;" edge="1" parent="1" source="gateway" target="order">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e3" value="Pay(req)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#6c8ebf;fontColor=#243b53;" edge="1" parent="1" source="order" target="strategy">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e4" value="创建收银台 URL / QR" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#666666;fontColor=#444444;" edge="1" parent="1" source="strategy" target="provider">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e5" value="先落 PENDING，再返回支付凭证" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#82b366;fontColor=#285943;" edge="1" parent="1" source="order" target="db">
          <mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="740" y="250" /><mxPoint x="1600" y="250" /></Array></mxGeometry>
        </mxCell>
        <mxCell id="note1" value="同步回跳 GET /payment/status：服务端仍查渠道；当前代码未发现独立 60 秒后台查单任务" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#6b5500;" vertex="1" parent="1">
          <mxGeometry x="90" y="270" width="610" height="60" as="geometry" />
        </mxCell>
        <mxCell id="note2" value="异步通知 POST /payment/notify：验签后再次 QueryPaymentStatus，通知与查单的订单号、流水号、状态、金额必须一致" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#6b5500;" vertex="1" parent="1">
          <mxGeometry x="760" y="270" width="850" height="60" as="geometry" />
        </mxCell>
        <mxCell id="e6" value="回跳 / 异步通知" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;dashed=1;endArrow=block;endFill=1;strokeColor=#d79b00;fontColor=#7a4b00;" edge="1" parent="1" source="provider" target="gateway">
          <mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1350" y="390" /><mxPoint x="440" y="390" /></Array></mxGeometry>
        </mxCell>
        <mxCell id="e7" value="SyncPaymentReturn / Notification" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#d79b00;fontColor=#7a4b00;" edge="1" parent="1" source="gateway" target="order">
          <mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="440" y="420" /><mxPoint x="740" y="420" /></Array></mxGeometry>
        </mxCell>
        <mxCell id="e8" value="Verify + Query" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#6c8ebf;fontColor=#243b53;" edge="1" parent="1" source="order" target="strategy">
          <mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="740" y="440" /><mxPoint x="1040" y="440" /></Array></mxGeometry>
        </mxCell>
        <mxCell id="e9" value="渠道最终状态" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#666666;fontColor=#444444;" edge="1" parent="1" source="strategy" target="provider">
          <mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1040" y="450" /><mxPoint x="1350" y="450" /></Array></mxGeometry>
        </mxCell>
        <mxCell id="stateTitle" value="二、统一状态与并发收敛" style="text;html=1;strokeColor=none;fillColor=none;fontStyle=1;fontColor=#243b53;fontSize=16;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="500" width="500" height="30" as="geometry" />
        </mxCell>
        <mxCell id="pending" value="PENDING&#xa;待支付 / WAIT_BUYER_PAY" style="ellipse;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#6b5500;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="150" y="700" width="220" height="90" as="geometry" />
        </mxCell>
        <mxCell id="sync" value="统一持久化入口&#xa;金额校验 + 渠道状态映射" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontColor=#4d2d5f;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="500" y="650" width="260" height="100" as="geometry" />
        </mxCell>
        <mxCell id="cas" value="乐观锁 CAS&#xa;status=PENDING AND version=?&#xa;RowsAffected=0 即幂等跳过" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontColor=#7a4b00;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="500" y="820" width="260" height="100" as="geometry" />
        </mxCell>
        <mxCell id="success" value="SUCCESS&#xa;订单 → 待发货" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#285943;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="930" y="620" width="220" height="90" as="geometry" />
        </mxCell>
        <mxCell id="closed" value="CLOSED&#xa;订单 → 已关闭" style="ellipse;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontColor=#7c2626;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="930" y="820" width="220" height="90" as="geometry" />
        </mxCell>
        <mxCell id="event" value="状态确实变化后&#xa;order.status.changed&#xa;支付事件下游消费可幂等" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#6b5500;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1280" y="650" width="280" height="100" as="geometry" />
        </mxCell>
        <mxCell id="frontend2" value="paymentReturn&#xa;成功：停止轮询并加载投放卡片&#xa;超时：显示待确认，不宣称失败" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#243b53;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1280" y="820" width="330" height="100" as="geometry" />
        </mxCell>
        <mxCell id="s1" value="查询结果" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#9673a6;fontColor=#4d2d5f;" edge="1" parent="1" source="pending" target="sync">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="s2" value="进入事务" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#d79b00;fontColor=#7a4b00;" edge="1" parent="1" source="sync" target="cas">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="s3" value="支付成功" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#82b366;fontColor=#285943;" edge="1" parent="1" source="cas" target="success">
          <mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="800" y="870" /><mxPoint x="800" y="665" /></Array></mxGeometry>
        </mxCell>
        <mxCell id="s4" value="渠道关闭 / 超时关单后同步" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#b85450;fontColor=#7c2626;" edge="1" parent="1" source="cas" target="closed">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="s5" value="仅真正迁移时发布" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;dashed=1;endArrow=block;endFill=1;strokeColor=#d6b656;fontColor=#6b5500;" edge="1" parent="1" source="success" target="event">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="s6" value="重复回调 / 重复轮询也复用同一入口" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;dashed=1;endArrow=block;endFill=1;strokeColor=#6c8ebf;fontColor=#243b53;" edge="1" parent="1" source="event" target="frontend2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="legend" value="图例：蓝=前端/抽象；橙=网关或并发控制；紫=订单统一入口；绿=持久化/成功；灰虚线=外部渠道或占位；黄=事件/提醒" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c7d2e0;fontColor=#52606d;fontSize=12;align=left;" vertex="1" parent="1">
          <mxGeometry x="60" y="1030" width="1550" height="45" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
