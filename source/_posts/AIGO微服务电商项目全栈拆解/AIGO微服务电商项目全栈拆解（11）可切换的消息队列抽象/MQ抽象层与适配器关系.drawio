<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="drawio" version="26.0">
  <diagram name="MQ 抽象层与适配器关系">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1000" math="0" shadow="0" background="#ffffff">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="2" value="业务使用侧" style="text;html=1;align=left;verticalAlign=middle;fontStyle=1;fontSize=18;fontColor=#404040;" vertex="1" parent="1">
          <mxGeometry x="60" y="40" width="330" height="40" as="geometry" />
        </mxCell>
        <mxCell id="3" value="provider-neutral 抽象层（pkg/mq/mq.go）" style="text;html=1;align=left;verticalAlign=middle;fontStyle=1;fontSize=18;fontColor=#404040;" vertex="1" parent="1">
          <mxGeometry x="500" y="40" width="430" height="40" as="geometry" />
        </mxCell>
        <mxCell id="4" value="适配器与实现状态" style="text;html=1;align=left;verticalAlign=middle;fontStyle=1;fontSize=18;fontColor=#404040;" vertex="1" parent="1">
          <mxGeometry x="1040" y="40" width="400" height="40" as="geometry" />
        </mxCell>

        <mxCell id="5" value="业务服务&#xa;只依赖 Client / Producer / Consumer" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=15;" vertex="1" parent="1">
          <mxGeometry x="60" y="140" width="330" height="80" as="geometry" />
        </mxCell>
        <mxCell id="6" value="micro-mall Gateway&#xa;GetMQClient → mq.GetClient" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=15;" vertex="1" parent="1">
          <mxGeometry x="60" y="270" width="330" height="90" as="geometry" />
        </mxCell>
        <mxCell id="7" value="micro-mall-admin&#xa;web.go 直接 NewRabbitMQClient" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=15;" vertex="1" parent="1">
          <mxGeometry x="60" y="410" width="330" height="90" as="geometry" />
        </mxCell>
        <mxCell id="8" value="应用层不处理 AMQP / RabbitMQ SDK 类型" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=15;" vertex="1" parent="1">
          <mxGeometry x="60" y="550" width="330" height="80" as="geometry" />
        </mxCell>

        <mxCell id="10" value="Client&#xa;创建生产者、消费者与生命周期关闭" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=15;" vertex="1" parent="1">
          <mxGeometry x="500" y="130" width="390" height="100" as="geometry" />
        </mxCell>
        <mxCell id="11" value="Producer / DelayedProducer&#xa;Publish · PublishBatch · 延迟发布" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=15;" vertex="1" parent="1">
          <mxGeometry x="500" y="300" width="390" height="100" as="geometry" />
        </mxCell>
        <mxCell id="12" value="Consumer / Subscription&#xa;Subscribe · Close" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=15;" vertex="1" parent="1">
          <mxGeometry x="500" y="470" width="390" height="90" as="geometry" />
        </mxCell>
        <mxCell id="13" value="Message / Delivery / ConsumeResult&#xa;Ack · Retry · Reject · Attempt" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=15;" vertex="1" parent="1">
          <mxGeometry x="500" y="630" width="390" height="100" as="geometry" />
        </mxCell>

        <mxCell id="20" value="RabbitMQ 适配器（已实现单条路径）&#xa;AMQP 1.0 · topic.exchange · group queue&#xa;编译期断言覆盖 Client / Producer / Consumer" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=15;" vertex="1" parent="1">
          <mxGeometry x="1040" y="120" width="430" height="140" as="geometry" />
        </mxCell>
        <mxCell id="21" value="内存实现（当前占位）&#xa;方法签名与抽象接口未对齐&#xa;尚未实现 Client / 投递 / 延迟调度" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=15;" vertex="1" parent="1">
          <mxGeometry x="1040" y="330" width="430" height="120" as="geometry" />
        </mxCell>
        <mxCell id="22" value="批量方法（当前占位）&#xa;PublishBatch / PublishDelayedBatch&#xa;返回空 BatchResult，不发布消息" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=15;" vertex="1" parent="1">
