        <mxCell id="2" value="购买后投放：责任链求值与支付边界" style="rounded=1;whiteSpace=wrap;html=1;fontStyle=1;fontSize=19;fillColor=#1f2937;strokeColor=#111827;fontColor=#ffffff;" vertex="1" parent="1">
