  <diagram name="快照关系图">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="2" value="sms_delivery_*：配置、评估与历史快照" style="rounded=1;whiteSpace=wrap;html=1;fontStyle=1;fontSize=19;fillColor=#1f2937;strokeColor=#111827;fontColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="30" y="25" width="1540" height="50" as="geometry" /></mxCell>
        <mxCell id="3" value="左侧是 admin 控制面，中央是订单级评估，右侧是冻结后的展示结果；历史订单不回读当前计划文案。" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=12;fillColor=#e5f6fd;strokeColor=#0e7490;fontColor=#164e63;" vertex="1" parent="1"><mxGeometry x="30" y="90" width="1540" height="42" as="geometry" /></mxCell>
        <mxCell id="10" value="admin 配置服务&#xa;/deliveryCampaign/*&#xa;白名单 + JSON schema + 版本校验" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="60" y="220" width="250" height="105" as="geometry" /></mxCell>
        <mxCell id="11" value="sms_delivery_campaign&#xa;id / enabled / priority&#xa;有效期 / version&#xa;卡片文案" style="swimlane;whiteSpace=wrap;html=1;startSize=30;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="390" y="185" width="280" height="205" as="geometry" /></mxCell>
        <mxCell id="12" value="sms_delivery_condition&#xa;campaign_id&#xa;condition_type（白名单）&#xa;operator + config_value JSON&#xa;sort_order" style="swimlane;whiteSpace=wrap;html=1;startSize=30;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="390" y="470" width="280" height="210" as="geometry" /></mxCell>
        <mxCell id="13" value="order + member context&#xa;order_sn / member_id&#xa;支付金额、商品、会员属性" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="60" y="505" width="250" height="95" as="geometry" /></mxCell>
        <mxCell id="14" value="sms_delivery_evaluation&#xa;order_sn UNIQUE&#xa;member_id / evaluated_at&#xa;context_snapshot JSON&#xa;零命中也保留一行" style="swimlane;whiteSpace=wrap;html=1;startSize=30;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="790" y="230" width="300" height="220" as="geometry" /></mxCell>
        <mxCell id="15" value="sms_delivery_hit&#xa;evaluation_id + campaign_id UNIQUE&#xa;campaign_version&#xa;display_order&#xa;卡片字段快照" style="swimlane;whiteSpace=wrap;html=1;startSize=30;fillColor=#dcfce7;strokeColor=#22c55e;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1210" y="230" width="300" height="220" as="geometry" /></mxCell>
        <mxCell id="16" value="并发请求 A / B&#xa;同一 orderSn" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eff6ff;strokeColor=#60a5fa;" vertex="1" parent="1"><mxGeometry x="740" y="570" width="170" height="80" as="geometry" /></mxCell>
        <mxCell id="17" value="唯一键冲突&#xa;B 回读已提交 evaluation + hits" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fee2e2;strokeColor=#ef4444;fontColor=#991b1b;" vertex="1" parent="1"><mxGeometry x="1010" y="570" width="220" height="80" as="geometry" /></mxCell>
        <mxCell id="18" value="配置更新：version + 1&#xa;替换条件只影响未来评估&#xa;历史 hit 不变" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#fff7ed;strokeColor=#f97316;fontColor=#9a3412;" vertex="1" parent="1"><mxGeometry x="390" y="760" width="350" height="105" as="geometry" /></mxCell>
        <mxCell id="19" value="评估事务&#xa;evaluation INSERT&#xa;→ hit INSERT（0..3）&#xa;一起提交或一起回滚" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#eef2ff;strokeColor=#6366f1;fontColor=#312e81;" vertex="1" parent="1"><mxGeometry x="790" y="760" width="300" height="105" as="geometry" /></mxCell>
        <mxCell id="20" value="历史读取路径&#xa;先读 evaluation，再读 hits&#xa;不重新求值" style="rounded=1;whiteSpace=wrap;;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#f3e8ff;strokeColor=#8b5cf6;fontColor=#581c87;" vertex="1" parent="1"><mxGeometry x="1210" y="760" width="300" height="105" as="geometry" /></mxCell>
