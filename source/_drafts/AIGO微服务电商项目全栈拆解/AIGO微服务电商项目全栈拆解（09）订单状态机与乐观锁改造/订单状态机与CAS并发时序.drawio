        <mxCell id="2" value="订单状态机 + CAS 并发时序（当前代码核实；退货边界见橙色说明）" style="rounded=1;whiteSpace=wrap;html=1;fontStyle=1;fontSize=18;fillColor=#1f2937;strokeColor=#111827;fontColor=#ffffff;" vertex="1" parent="1">
