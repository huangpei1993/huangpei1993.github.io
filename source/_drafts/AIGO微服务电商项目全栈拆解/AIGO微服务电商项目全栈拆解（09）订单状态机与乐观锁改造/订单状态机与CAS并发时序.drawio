        </mxCell>
        <mxCell id="66" value="5. 返回 CodeOrderStatusVersionConflict&#xa;不执行取消补偿" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fee2e2;strokeColor=#ef4444;" vertex="1" parent="1">
          <mxGeometry x="1060" y="735" width="250" height="62" as="geometry" />
