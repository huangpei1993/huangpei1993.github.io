{
  "title": "AIGO 主链路时序",
  "participants": [
    {"id": "user", "label": "用户/浏览器", "actor": true},
    {"id": "gateway", "label": "Gateway HTTP/BFF"},
    {"id": "member", "label": "Member gRPC"},
    {"id": "product", "label": "Product gRPC"},
    {"id": "cart", "label": "Cart gRPC"},
    {"id": "promotion", "label": "Promotion gRPC"},
    {"id": "order", "label": "Order gRPC"},
    {"id": "payment", "label": "支付平台"},
    {"id": "mq", "label": "RabbitMQ"},
    {"id": "admin", "label": "Admin Gin"},
    {"id": "timer", "label": "定时任务"}
  ],
  "messages": [
    {"note": "实线=同步 HTTP/gRPC；虚线=异步消息或后台任务；支付平台通知是异步 HTTP，不是 MQ。", "over": "gateway"},
    {"from": "user", "to": "gateway", "label": "注册/登录 HTTP"},
    {"from": "gateway", "to": "member", "label": "Register / Login gRPC"},
    {"from": "member", "to": "gateway", "label": "Token / memberId", "return": true},
    {"from": "gateway", "to": "user", "label": "登录结果", "return": true},
    {"from": "user", "to": "gateway", "label": "首次登录态请求：浏览首页/商品"},
    {"from": "gateway", "to": "gateway", "label": "Auth 校验 JWT；FirstAccess 标记当日首访", "activate": false},
    {"from": "gateway", "to": "mq", "label": "gateway.first-access：异步发布", "async": true},
    {"from": "mq", "to": "member", "label": "消费首访消息：每日积分", "async": true},
    {"from": "member", "to": "member", "label": "账本业务键幂等入账", "activate": false},
    {"from": "gateway", "to": "promotion", "label": "首页运营位/推荐列表 gRPC"},
    {"from": "promotion", "to": "gateway", "label": "首页数据", "return": true},
    {"from": "gateway", "to": "product", "label": "商品详情/分类 gRPC"},
    {"from": "product", "to": "gateway", "label": "商品数据", "return": true},
    {"from": "gateway", "to": "user", "label": "浏览页面响应", "return": true},
    {"from": "user", "to": "gateway", "label": "加购 HTTP"},
    {"from": "gateway", "to": "cart", "label": "CartAdd gRPC"},
    {"from": "cart", "to": "gateway", "label": "加购成功", "return": true},
    {"from": "gateway", "to": "user", "label": "200 OK", "return": true},
    {"from": "user", "to": "gateway", "label": "确认订单/金额试算 HTTP"},
    {"from": "gateway", "to": "order", "label": "GenerateConfirmOrder gRPC"},
    {"from": "order", "to": "cart", "label": "读取选中购物车行"},
    {"from": "cart", "to": "order", "label": "购物车快照", "return": true},
    {"from": "order", "to": "member", "label": "地址/会员/积分快照"},
    {"from": "member", "to": "order", "label": "会员结算信息", "return": true},
    {"from": "order", "to": "promotion", "label": "优惠券可用性/抵扣试算"},
    {"from": "promotion", "to": "order", "label": "优惠券试算结果", "return": true},
    {"from": "order", "to": "gateway", "label": "确认单基础数据", "return": true},
    {"from": "gateway", "to": "cart", "label": "展示用购物车明细"},
    {"from": "cart", "to": "gateway", "label": "明细", "return": true},
    {"from": "gateway", "to": "promotion", "label": "逐券计算匹配商品"},
    {"from": "promotion", "to": "gateway", "label": "可选优惠券列表", "return": true},
    {"from": "gateway", "to": "user", "label": "确认单：金额/积分/优惠券", "return": true},
    {"from": "user", "to": "gateway", "label": "提交订单 HTTP"},
    {"from": "gateway", "to": "order", "label": "GenerateOrder gRPC"},
    {"from": "order", "to": "cart", "label": "读取选中行"},
    {"from": "cart", "to": "order", "label": "购物车数据", "return": true},
    {"from": "order", "to": "product", "label": "按订单号预占库存"},
    {"from": "product", "to": "order", "label": "预占结果", "return": true},
    {"from": "order", "to": "member", "label": "扣减已用积分/补齐会员信息"},
    {"from": "member", "to": "order", "label": "扣减结果", "return": true},
    {"from": "order", "to": "promotion", "label": "标记优惠券已使用"},
    {"from": "promotion", "to": "order", "label": "使用结果", "return": true},
    {"from": "order", "to": "order", "label": "本地事务：订单/明细落库", "activate": false},
    {"from": "order", "to": "cart", "label": "提交后删除购物车行"},
    {"from": "cart", "to": "order", "label": "删除结果", "return": true},
    {"from": "order", "to": "mq", "label": "order.expiration：延迟关单消息", "async": true},
    {"from": "order", "to": "gateway", "label": "orderSn / paymentRequired", "return": true},
    {"from": "gateway", "to": "user", "label": "下单结果", "return": true},
    {"from": "user", "to": "gateway", "label": "准备支付 HTTP"},
    {"from": "gateway", "to": "order", "label": "PreparePayment gRPC"},
    {"from": "order", "to": "payment", "label": "创建二维码/收银台"},
    {"from": "payment", "to": "order", "label": "支付入口", "return": true},
    {"from": "order", "to": "order", "label": "写入/刷新 PENDING 流水", "activate": false},
    {"from": "order", "to": "gateway", "label": "二维码/收银台 URL", "return": true},
    {"from": "user", "to": "payment", "label": "在支付平台完成付款"},
    {"from": "payment", "to": "gateway", "label": "异步通知/同步回跳 HTTP", "async": true},
    {"from": "gateway", "to": "order", "label": "SyncPayment：验签/查单/同步状态"},
    {"from": "order", "to": "payment", "label": "再次查单确认"},
    {"from": "payment", "to": "order", "label": "SUCCESS/CLOSED", "return": true},
    {"from": "order", "to": "order", "label": "事务：支付流水 + 订单 0→1", "activate": false},
    {"from": "order", "to": "mq", "label": "order.status.changed：pay", "async": true},
    {"from": "mq", "to": "member", "label": "消费 pay：积分/成长值结算", "async": true},
    {"from": "member", "to": "member", "label": "PAYMENT 账本幂等入账", "activate": false},
    {"from": "mq", "to": "admin", "label": "消费状态消息：管理端投影", "async": true},
    {"from": "admin", "to": "admin", "label": "校验版本并更新 order 库", "activate": false},
    {"from": "gateway", "to": "promotion", "label": "支付后 GET delivery/{orderSn}"},
    {"from": "promotion", "to": "gateway", "label": "最多 3 张投放卡片/快照", "return": true},
    {"from": "gateway", "to": "user", "label": "投放卡片", "return": true},
    {"from": "admin", "to": "admin", "label": "运营人员发货：物流策略 + 写物流快照", "activate": false},
    {"from": "admin", "to": "mq", "label": "order.status.changed：ship", "async": true},
    {"from": "user", "to": "gateway", "label": "查询订单/物流 HTTP"},
    {"from": "gateway", "to": "order", "label": "订单详情 gRPC"},
    {"from": "order", "to": "gateway", "label": "订单状态 + 物流快照", "return": true},
    {"from": "gateway", "to": "user", "label": "物流轨迹", "return": true},
    {"from": "timer", "to": "admin", "label": "每 5 分钟同步已发货物流", "async": true},
    {"from": "admin", "to": "admin", "label": "local provider 生成/推进轨迹", "activate": false},
    {"from": "user", "to": "gateway", "label": "确认收货 HTTP"},
    {"from": "gateway", "to": "order", "label": "ConfirmReceipt gRPC"},
    {"from": "order", "to": "order", "label": "CAS：订单 2→3", "activate": false},
    {"from": "order", "to": "mq", "label": "order.status.changed：confirm_receipt", "async": true},
    {"from": "timer", "to": "mq", "label": "每 1 小时扫描并投递 auto-receipt 延迟消息", "async": true},
    {"from": "mq", "to": "order", "label": "到期消费：自动确认收货", "async": true},
    {"from": "order", "to": "mq", "label": "order.status.changed：auto_confirm_receipt", "async": true},
    {"from": "user", "to": "gateway", "label": "申请售后/提交退货物流 HTTP"},
    {"from": "gateway", "to": "order", "label": "CreateAfterSale / SubmitLogistics gRPC"},
    {"from": "order", "to": "gateway", "label": "售后单状态", "return": true},
    {"from": "admin", "to": "mq", "label": "after-sale.command：APPROVE/REJECT/CONFIRM_RECEIVE", "async": true},
    {"from": "mq", "to": "order", "label": "消费售后命令", "async": true},
    {"from": "order", "to": "payment", "label": "查退款/发起退款"},
    {"from": "payment", "to": "order", "label": "退款结果", "return": true},
    {"from": "order", "to": "member", "label": "返还/撤销积分成长值"},
    {"from": "member", "to": "order", "label": "账本处理结果", "return": true},
    {"from": "user", "to": "gateway", "label": "申请/下载发票 HTTP"},
    {"from": "gateway", "to": "order", "label": "ApplyInvoice / DownloadInvoice gRPC"},
    {"from": "order", "to": "gateway", "label": "发票号或 PDF", "return": true},
    {"from": "gateway", "to": "user", "label": "发票结果", "return": true}
  ]
}
