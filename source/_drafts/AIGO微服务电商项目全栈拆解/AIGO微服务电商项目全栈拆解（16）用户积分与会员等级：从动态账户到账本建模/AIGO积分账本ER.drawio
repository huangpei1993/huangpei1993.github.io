        <mxCell id="ledger" value="&lt;b&gt;ums_point_ledger&lt;/b&gt; · V2&lt;br&gt;PK id : bigint&lt;br&gt;member_id / event_type / entry_type&lt;br&gt;biz_key / points_delta / balance_after&lt;br&gt;remaining_points&lt;br&gt;source_ledger_id&lt;br&gt;event_time / created_at&lt;br&gt;&lt;font color='#0f766e'&gt;GRANT/RETURN 是可消费来源；CONSUME/REVOKE/EXPIRE 指向来源&lt;/font&gt;" style="shape=table;html=1;whiteSpace=wrap;rounded=0;fillColor=#ecfdf5;strokeColor=#059669;fontColor=#064e3b;align=left;verticalAlign=top;spacing=12;fontSize=12;" vertex="1" parent="1">
