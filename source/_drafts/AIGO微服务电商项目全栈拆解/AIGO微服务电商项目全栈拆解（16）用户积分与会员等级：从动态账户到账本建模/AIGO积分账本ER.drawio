        <mxCell id="title" value="AIGO 用户积分与会员等级 · V2 账本模型" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=24;fontStyle=1;fontColor=#0f172a;" vertex="1" parent="1">
          <mxGeometry x="40" y="30" width="800" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="subtitle" value="动态账户是当前投影，账本保存可审计事实；批次职责已并入积分账本" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=13;fontColor=#64748b;" vertex="1" parent="1">
          <mxGeometry x="40" y="70" width="1000" height="30" as="geometry"/>
        </mxCell>

        <mxCell id="member" value="&lt;b&gt;ums_member&lt;/b&gt;&lt;br&gt;PK id : bigint&lt;br&gt;username / status&lt;br&gt;认证与静态资料&lt;br&gt;&lt;font color='#64748b'&gt;V1 迁移后不再保存积分/成长值&lt;/font&gt;" style="shape=table;html=1;whiteSpace=wrap;rounded=0;fillColor=#f8fafc;strokeColor=#94a3b8;fontColor=#334155;align=left;verticalAlign=top;spacing=12;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="130" width="260" height="170" as="geometry"/>
        </mxCell>
        <mxCell id="account" value="&lt;b&gt;ums_member_account&lt;/b&gt;&lt;br&gt;PK member_id : bigint&lt;br&gt;point_balance : bigint&lt;br&gt;frozen_points : bigint&lt;br&gt;growth : bigint&lt;br&gt;member_level_id : bigint?&lt;br&gt;version : bigint&lt;br&gt;&lt;font color='#0f766e'&gt;当前动态账户投影&lt;/font&gt;" style="shape=table;html=1;whiteSpace=wrap;rounded=0;fillColor=#ecfdf5;strokeColor=#0f766e;fontColor=#134e4a;align=left;verticalAlign=top;spacing=12;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="350" y="120" width="330" height="220" as="geometry"/>
        </mxCell>
        <mxCell id="level" value="&lt;b&gt;ums_member_level&lt;/b&gt;&lt;br&gt;PK id : bigint&lt;br&gt;name : varchar&lt;br&gt;growth_point : bigint&lt;br&gt;权益配置...&lt;br&gt;&lt;font color='#64748b'&gt;按最高 growth_point ≤ growth 匹配&lt;/font&gt;" style="shape=table;html=1;whiteSpace=wrap;rounded=0;fillColor=#eff6ff;strokeColor=#2563eb;fontColor=#1e3a8a;align=left;verticalAlign=top;spacing=12;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="740" y="130" width="270" height="180" as="geometry"/>
        </mxCell>
        <mxCell id="outbox" value="&lt;b&gt;oms_member_event_outbox&lt;/b&gt;&lt;br&gt;PK id : bigint&lt;br&gt;UK event_key&lt;br&gt;event_type / order_sn&lt;br&gt;payload : json&lt;br&gt;status / retry_count / next_retry_at&lt;br&gt;&lt;font color='#b45309'&gt;表与生成模型存在；当前发布路径仍直连 MQ&lt;/font&gt;" style="shape=table;html=1;whiteSpace=wrap;rounded=0;fillColor=#fffbeb;strokeColor=#d97706;fontColor=#78350f;align=left;verticalAlign=top;spacing=12;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1080" y="120" width="360" height="220" as="geometry"/>
        </mxCell>

        <mxCell id="reservation" value="&lt;b&gt;ums_point_reservation&lt;/b&gt;&lt;br&gt;PK id : bigint&lt;br&gt;member_id / order_sn&lt;br&gt;points : bigint&lt;br&gt;status : PENDING / COMMITTED / RELEASED / EXPIRED&lt;br&gt;expires_at&lt;br&gt;&lt;font color='#64748b'&gt;订单积分预占主记录&lt;/font&gt;" style="shape=table;html=1;whiteSpace=wrap;rounded=0;fillColor=#fff7ed;strokeColor=#ea580c;fontColor=#7c2d12;align=left;verticalAlign=top;spacing=12;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="430" width="330" height="210" as="geometry"/>
